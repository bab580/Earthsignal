# No NASA API key is required for the initial public POWER daily endpoint.
# Configure a custom timeout if needed:
NASA_POWER_TIMEOUT_SECONDS=30

# NASA AppEEARS is free but requires a NASA Earthdata Login.
# Copy this file to .env locally and fill these in; never commit .env.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_APPEEARS_TIMEOUT_SECONDS=30
NASA_APPEEARS_TASK_TIMEOUT_SECONDS=180

# ESP32 sensor ingestion. Use a long unique token for the device and backend.
EARTHSIGNAL_DEVICE_TOKEN=
EARTHSIGNAL_SENSOR_DB=backend/earthsignal_sensors.sqlite3
# Comma-separated, exact browser origins allowed to call the API.
EARTHSIGNAL_CORS_ORIGINS=
# Only enable unauthenticated ingestion on a trusted local demo network.
EARTHSIGNAL_ALLOW_UNAUTHENTICATED_SENSOR_INGESTION=false

# Africa's Talking SMS. Keep credentials on the backend; never put them in the frontend.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Set true only with Africa's Talking sandbox credentials.
AFRICASTALKING_SANDBOX=true
# Default 05:00 UTC = 08:00 in Uganda (Africa/Kampala).
EARTHSIGNAL_SMS_SEND_HOUR_UTC=5
